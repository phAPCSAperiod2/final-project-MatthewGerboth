{
  // === AI & Inline Suggestions (Classroom policy) ===
  "github.copilot.inlineSuggest.enable": false,
  "editor.inlineSuggest.enabled": false,

  // === Editor ergonomics ===
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // === Java (AP CSA friendly) ===
  "java.inlayHints.parameterNames.enabled": "literals",
  "java.inlayHints.parameterNames.exclusions": ["println"],


  "java.format.settings.url": "eclipse-formatter.xml",
  "java.format.settings.profile": "GoogleStyle",
  "java.saveActions.organizeImports": true,

  "java.test.config": [
    {
      "name": "JUnit (Default)",
      "workingDirectory": "${workspaceFolder}",
      "args": [],
      "vmArgs": []
    }
  ],

  "java.test.defaultConfig": "JUnit (Default)",

  "problems.showCurrentInStatus": true,
  "java.errors.incompleteClasspath.severity": "warning",
  "java.compile.nullAnalysis.mode": "automatic",

  "files.exclude": {
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/bin": true,
    "**/out": true,
    "**/target": true
  },

  "java.project.sourcePaths": ["src"],
  "java.project.referencedLibraries": [],

  "githubPullRequests.ignoredPullRequestBranches": ["main"]
}
